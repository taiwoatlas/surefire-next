# ---------------------------------------------------------------------------
# The Surefire Christian Church of God — environment variables
# Copy to .env.local and fill in real values. Never commit .env.local.
# ---------------------------------------------------------------------------

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://surefirechristianchurch.org

# --- WhatsApp (used to build wa.me links server- and client-side) ---
NEXT_PUBLIC_WHATSAPP_CHURCH_NUMBER=2349115905137
NEXT_PUBLIC_WHATSAPP_SENIOR_PASTOR_NUMBER=2348032273433

# --- Maps (only if the embedded map moves off a bare iframe) ---
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- Database (only needed once server-side form persistence is required) ---
DATABASE_URL=

# --- Email notifications (only needed once forms send email as well as WhatsApp) ---
EMAIL_FROM=
RESEND_API_KEY=

# --- Analytics (privacy-conscious; omit entirely if not used) ---
NEXT_PUBLIC_ANALYTICS_ID=

# --- Error monitoring ---
SENTRY_DSN=

# --- Future CMS (Sanity/Payload/Strapi/Contentful) — placeholders only ---
CMS_API_URL=
CMS_API_TOKEN=
